<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>enable</Nullable>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!--
          Enabling XML output exposes 178 pre-existing undocumented public
          members. Preserve authored documentation in the package without
          manufacturing filler comments; complete API documentation remains
          an explicit follow-up.
        -->
        <NoWarn>$(NoWarn);1591</NoWarn>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <DebugType>portable</DebugType>
        <Deterministic>true</Deterministic>
        <!-- Must stay single-line: MSBuild does not trim property values, and the
             SDK gates DeterministicSourcePaths on the exact string "true". -->
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- NuGet Package Metadata -->
        <PackageId>PhoenixSharp</PackageId>
        <Version>2.0.0</Version>
        <Authors>Maz Jaleel</Authors>
        <Description>A C# Phoenix Channels client for real-time communication with Phoenix (Elixir) servers. Unity compatible. Supports automatic reconnection, presence tracking, and pluggable websocket/serializer implementations.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Mazyod/PhoenixSharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Mazyod/PhoenixSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>phoenix;channels;websocket;unity;realtime;elixir;socket</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PhoenixTests" />
    </ItemGroup>

    <!-- Link source files from Unity package (single source of truth) -->
    <ItemGroup>
        <Compile Include="../src/PhoenixSharp.Unity/Assets/Plugins/PhoenixSharp/Runtime/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Microsoft.SourceLink.GitHub"
            Version="8.0.0"
            PrivateAssets="All"
        />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    </ItemGroup>
</Project>
