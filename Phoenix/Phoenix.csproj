<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>enable</Nullable>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>

        <!-- NuGet Package Metadata -->
        <PackageId>PhoenixSharp</PackageId>
        <Version>1.0.0</Version>
        <Authors>Maz Jaleel</Authors>
        <Description>A C# Phoenix Channels client for real-time communication with Phoenix (Elixir) servers. Unity compatible. Supports automatic reconnection, presence tracking, and pluggable websocket/serializer implementations.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Mazyod/PhoenixSharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Mazyod/PhoenixSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>phoenix;channels;websocket;unity;realtime;elixir;socket</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PhoenixTests" />
    </ItemGroup>

    <!-- Link source files from Unity package (single source of truth) -->
    <ItemGroup>
        <Compile Include="../src/PhoenixSharp.Unity/Assets/Plugins/PhoenixSharp/Runtime/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    </ItemGroup>
</Project>
